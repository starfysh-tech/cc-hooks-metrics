#!/usr/bin/env bash
# hooktime - Measure and record hook/step execution.
# Usage: hooktime SOURCE HOOK STEP CMD [args...]
#
# Sourceable (`. hooktime`) or executable directly.
# Writes JSONL metrics to $HOOKPERF_LOG / $CLAUDE_METRICS_LOG / ~/.claude/hook-metrics.log

# JSON-escape helper: escapes backslashes, double-quotes, and tabs
_json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e $'s/\t/\\\\t/g'; }

hooktime() {
  local source_name="$1" hook="$2" step="$3"
  shift 3
  local cmd_name="$1"
  local log_file="${HOOKPERF_LOG:-${CLAUDE_METRICS_LOG:-$HOME/.claude/hook-metrics.log}}"

  # Ensure log directory exists
  mkdir -p "$(dirname "$log_file")"

  # Timestamps and git metadata
  local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local branch sha host_name repo
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
  sha="$(git rev-parse --short HEAD 2>/dev/null || echo "")"
  host_name="$(hostname 2>/dev/null || echo "")"
  repo="$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || echo "")"

  # Temp file for timing data
  local time_file
  time_file=$(mktemp)
  trap 'rm -f "$time_file"' RETURN

  # Check if command is a shell function (/usr/bin/time can't exec functions)
  local _ht_is_func=false
  if type "$1" 2>/dev/null | grep -q 'function'; then
    _ht_is_func=true
  fi

  # Execute the command
  local exit_code
  if [[ "$_ht_is_func" == "true" ]]; then
    # Shell function: use perl Time::HiRes for ms-precision timing
    local _ht_start _ht_end
    _ht_start=$(perl -MTime::HiRes=time -e 'printf "%.3f\n", time')
    "$@"
    exit_code=$?
    _ht_end=$(perl -MTime::HiRes=time -e 'printf "%.3f\n", time')
    awk "BEGIN{printf \"real %.2f\n\", $_ht_end - $_ht_start}" > "$time_file"
  else
    /usr/bin/time -p -o "$time_file" "$@"
    exit_code=$?
  fi

  # Parse timing from /usr/bin/time output
  local real
  real=$(grep "^real" "$time_file" | awk '{print $2}')
  real="${real:-0}"
  local duration_ms
  duration_ms=$(awk "BEGIN{printf \"%.0f\", $real * 1000}")
  duration_ms="${duration_ms:-0}"

  # Write JSONL entry
  printf '{"ts":"%s","source":"%s","hook":"%s","step":"%s","cmd":"%s","exit_code":%d,"duration_ms":%s,"branch":"%s","sha":"%s","repo":"%s","host":"%s"}\n' \
    "$ts" \
    "$(_json_escape "$source_name")" \
    "$(_json_escape "$hook")" \
    "$(_json_escape "$step")" \
    "$(_json_escape "$cmd_name")" \
    "$exit_code" \
    "$duration_ms" \
    "$(_json_escape "$branch")" \
    "$(_json_escape "$sha")" \
    "$(_json_escape "$repo")" \
    "$(_json_escape "$host_name")" \
    >> "$log_file"

  return $exit_code
}

# Allow direct execution: hooktime SOURCE HOOK STEP CMD [args...]
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  hooktime "$@"
fi
